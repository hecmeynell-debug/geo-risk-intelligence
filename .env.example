# Copy to .env for local runs outside Docker. Compose supplies its own values.
# All settings are prefixed GRI_ (see src/gri/config.py).

GRI_ENVIRONMENT=local
GRI_DEBUG=false

# Inside Compose the host is "db"; from the host machine it is "localhost".
GRI_DATABASE_URL=postgresql+psycopg://gri:gri@localhost:5432/gri

GRI_API_HOST=0.0.0.0
GRI_API_PORT=8000

# Host-side ports for Docker Compose only. Change these if 5432 or 8000 are already
# in use on your machine; the container-side ports never change.
GRI_DB_HOST_PORT=5432
GRI_API_HOST_PORT=8000

# Identify honestly on every outbound request, with a contact route.
GRI_USER_AGENT=geo-risk-intelligence/0.1 (+https://github.com/example/geo-risk-intelligence)

# CONSTRAINTS.md pins polling to 30-60 minutes. Values outside that range are rejected.
GRI_POLL_INTERVAL_SECONDS=1800
GRI_HTTP_TIMEOUT_SECONDS=30

GRI_LOG_LEVEL=INFO
GRI_LOG_JSON=true

# Extraction (Phase 2). Optional: the whole test suite and CI run without it, against a
# scripted provider. Set it to make real extraction calls.
# .env is gitignored -- a key belongs here, never in code, compose files, or committed
# config.
# GRI_ANTHROPIC_API_KEY=sk-ant-...
